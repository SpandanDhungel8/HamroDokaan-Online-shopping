@model List<HamroDokaan.Models.Cart>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    decimal total = 0;
}

<style>
    .cart-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        padding: 15px;
        border-radius: 15px;
        margin-bottom: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .cart-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .cart-img {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        overflow: hidden;
    }

        .cart-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .qty-box {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
    }

    .qty-btn {
        text-decoration:none;
        background: #e76f51;
        color: white;
        border: none;
        padding: 4px 10px;
        border-radius: 6px;
        cursor: pointer;
    }

        .qty-btn:hover {
            background: #f4a261;
        }

    .total-box {
        text-align: right;
    }

    .remove-btn {
        margin-top: 5px;
        display: inline-block;
        background: white;
        padding: 5px 10px;
        border-radius: 6px;
        text-decoration: none;
        color: black;
    }

    .remove-btn:hover {
        background: orangered;
    }

    .grand-total {
        text-align: right;
        font-size: 18px;
        font-weight: bold;
        margin-top: 20px;
        color: #e76f51;
    }

    .btn-checkout {
        text-decoration:none;
        background: #e76f51;
        color: white;
        border: none;
        padding: 4px 10px;
        border-radius: 6px;
        cursor: pointer;
    }
    .btn-checkout {
            background: #f4a261;
    }
</style>

<h2> Your Cart</h2>

@foreach (var item in Model)
{
    var itemTotal = Convert.ToDecimal(item.Product.Product_Price) * item.Quantity;
    total += itemTotal;

    <div class="cart-card">

        <div class="cart-left">
            <div class="cart-img">
                <img src="~/img/@item.Product.Product_img" />
            </div>

            <div>
                <div><strong>@item.Product.Product_Name</strong></div>
                <div>Rs. @item.Product.Product_Price</div>

                
                <div class="qty-box">
                    <a class="qty-btn" asp-action="DecreaseQty" asp-route-id="@item.Cart_Id">-</a>
                    <span>@item.Quantity</span>
                    <a class="qty-btn" asp-action="IncreaseQty" asp-route-id="@item.Cart_Id">+</a>
                </div>
            </div>
        </div>

        <div class="total-box">
            <div><strong>Rs. @itemTotal</strong></div>

            <a class="remove-btn"
               asp-action="RemoveFromCart"
               asp-route-id="@item.Cart_Id">
                Remove
            </a>
          
        </div>
       
    </div> 
   
}
<a asp-action="Checkout" class="btn-checkout">Proceed to Checkout</a>
<div class="grand-total">
    Total: Rs. @total
</div>