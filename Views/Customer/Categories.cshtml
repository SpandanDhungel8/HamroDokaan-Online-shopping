@model List<HamroDokaan.Models.Category>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .page-title {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }

    .category-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .category-card {
        width: 220px;
        background: #fff;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        transition: 0.3s;
        position: relative;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.1);
        }

  

    .category-name {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .view-btn {
        text-decoration: none;
        color: #e76f51;
        font-weight: 500;
        font-size: 14px;
        transition: 0.2s;
    }

        .view-btn:hover {
            color: #f4a261;
        }
</style>

<div class="page-title">
    Categories
</div>

<div class="category-container">

    @foreach (var c in Model)
    {
        <div class="category-card">

           

            <div class="category-name">
                @c.Category_Name
            </div>

            <a class="view-btn" asp-action="Products" asp-controller="Customer" asp-route-id="@c.Category_Id">
                View Products 
            </a>

        </div>
    }

</div>