@model HamroDokaan.Models.User
@{
    Layout = null;
}
@{
    ViewData["Title"] = "Register";
}




<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600&family=DM+Serif+Display&display=swap" rel="stylesheet">

<style>
    body {
        margin: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #f6f1e9, #efe6d8);
        font-family: 'Space Grotesk', sans-serif;
        color: #2c2c2c;
    }

    .register-card {
        width: 360px;
        padding: 35px;
        border-radius: 18px;
        background: rgba(255, 250, 243, 0.75);
        backdrop-filter: blur(14px);
        border: 1px solid #e5d6c3;
        box-shadow: 8px 8px 0 #e0d4c2, 0 20px 40px rgba(0,0,0,0.08);
    }

    .register-title {
        font-family: 'DM Serif Display', serif;
        font-size: 28px;
        text-align: center;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            font-size: 13px;
            margin-bottom: 5px;
            display: block;
            color: #555;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            border: 1.5px solid #d6c7b0;
            background: #fffaf3;
            outline: none;
            transition: 0.3s;
        }

            .form-group input:focus {
                border-color: #2a9d8f;
                box-shadow: 0 0 0 2px rgba(42,157,143,0.15);
            }

    .register-btn {
        width: 100%;
        padding: 11px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(145deg, #f4a261, #e76f51);
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 4px 4px 0 #d8c8b2;
    }

        .register-btn:hover {
            transform: translateY(-2px);
            box-shadow: 6px 6px 0 #d8c8b2;
        }

        .register-btn:active {
            transform: scale(0.95);
            box-shadow: 2px 2px 0 #d8c8b2;
        }

    .login-link {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

        .login-link a {
            color: #e76f51;
            text-decoration: none;
            font-weight: 600;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    .Home-link {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

        .Home-link a {
            color: #e76f51;
            text-decoration: none;
            font-weight: 600;
        }

            .Home-link a:hover {
                text-decoration: underline;
            }

    .alert-box {
        max-width: 500px;
        margin: 20px auto;
        padding: 15px 20px;
        border-radius: 8px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        animation: fadeIn 0.5s ease-in-out;
    }

    .alert-success {
        background-color: #e6f9f0;
        color: #1e7e34;
        border-left: 5px solid #28a745;
    }

    .alert-icon {
        font-size: 18px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="register-card">

    <div class="register-title">Create Account</div>

    <form asp-action="Register" method="post">
        @if (TempData["Message"] != null)
        {
            <div class="alert-box alert-success">
                <span class="alert-icon"></span>
                <span>@TempData["Message"]</span>
            </div>
        }


        <div asp-validation-summary="All" style="color:red"></div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="User_Email" />
            <span asp-validation-for="User_Email" style="color:red"></span>
        </div>

        <div class="form-group">
            <label> Create Password</label>
            <input asp-for="User_Password" type="password" />
            <span asp-validation-for="User_Password" style="color:red"></span>
        </div>

        <button type="submit" class="register-btn">Register</button>
        <div class="Home-link">

            <a asp-action="Index" asp-controller="Home">Go To Home</a>
        </div>
        <div class="Login-link">
        
        <a asp-action="Login">Login</a>
    </div>
    </form>


</div>