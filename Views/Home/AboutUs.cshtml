@{
    ViewData["Title"] = "About Us";
}

<style>
    .about-container {
        max-width: 900px;
        margin: auto;
        text-align: center;
        padding: 60px 20px;
    }

    .about-title {
        font-size: 42px;
        font-weight: bold;
        color: #2b2b2b;
        text-shadow: 3px 3px 0 #e8d8c3;
        margin-bottom: 15px;
        transition: 0.3s;
    }

        .about-title span {
            color: #e76f51;
        }

        .about-title:hover {
            transform: rotate(-1deg) translateY(-3px);
            text-shadow: 6px 6px 0 #d8c8b2;
        }

    .about-sub {
        color: #6b5e55;
        margin-bottom: 40px;
        font-size: 16px;
    }

    .about-card {
        background: #fff8f0;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 6px 6px 0 #e6d5c3;
        margin-bottom: 25px;
        transition: 0.3s;
    }

        .about-card:hover {
            transform: translateY(-8px) rotate(-1deg);
            box-shadow: 10px 10px 0 #d8c3a5;
        }

        .about-card h3 {
            margin-bottom: 10px;
            color: #333;
        }

        .about-card p {
            color: #5c5148;
            font-size: 14px;
            line-height: 1.6;
        }

  
    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 40px;
    }

    .feature-box {
        background: #fdf2e9;
        padding: 20px;
        border-radius: 16px;
        box-shadow: 4px 4px 0 #e6d5c3;
        transition: 0.3s;
    }

        .feature-box:hover {
            transform: translateY(-6px);
            box-shadow: 8px 8px 0 #d8c3a5;
        }

        .feature-box i {
            font-size: 22px;
            color: #e76f51;
            margin-bottom: 10px;
        }

        .feature-box h4 {
            margin-bottom: 6px;
            color: #2b2b2b;
        }

        .feature-box p {
            font-size: 13px;
            color: #6b5e55;
        }
</style>

<div class="about-container">

    <div class="about-title">
        Hamro<span>Dokaan</span>
    </div>

    <p class="about-sub">
        A blend of retro charm and modern shopping 
    </p>

    <div class="about-card">
        <h3>Who We Are</h3>
        <p>
            HamroDokaan is not just another ecommerce site. We focus on delivering a
            smooth and enjoyable shopping experience with a unique visual identity.
        </p>
    </div>

    <div class="about-card">
        <h3>Our Mission</h3>
        <p>
            To make online shopping feel more personal, stylish, and engaging —
            not just functional. Every interaction is designed to feel premium
            yet simple.
        </p>
    </div>

    <div class="about-card">
        <h3> Why We Stand Out</h3>
        <p>
            Unlike typical ecommerce platforms, we combine aesthetics with usability.
            Our retro-modern design gives users a refreshing experience while keeping
            everything fast and easy.
        </p>
    </div>

    <div class="features">

        <div class="feature-box">
            <i class="fa-solid fa-bolt"></i>
            <h4>Fast</h4>
            <p>Quick and smooth experience</p>
        </div>

        <div class="feature-box">
            <i class="fa-solid fa-palette"></i>
            <h4>Stylish</h4>
            <p>Retro-modern design vibe</p>
        </div>

        <div class="feature-box">
            <i class="fa-solid fa-shield"></i>
            <h4>Secure</h4>
            <p>Safe and reliable platform</p>
        </div>

        <div class="feature-box">
            <i class="fa-solid fa-heart"></i>
            <h4>Made with Care</h4>
            <p>Built to feel premium</p>
        </div>

    </div>

</div>