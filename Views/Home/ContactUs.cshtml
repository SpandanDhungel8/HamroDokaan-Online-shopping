@{
    ViewData["Title"] = "Contact Us";
}
@if (TempData["Message"] != null)
{
    <div style="color: lightgreen; margin-bottom: 10px;">
        @TempData["Message"]
    </div>
}
<style>
    .contact-container {
        max-width: 800px;
        margin: auto;
        padding: 50px 20px;
        text-align: center;
    }

    .contact-title {
        font-size: 40px;
        font-weight: bold;
        color: #2b2b2b;
        text-shadow: 3px 3px 0 #e8d8c3;
        margin-bottom: 10px;
        transition: 0.3s;
    }

        .contact-title span {
            color: #e76f51;
        }

        .contact-title:hover {
            transform: rotate(-1deg) translateY(-3px);
            text-shadow: 6px 6px 0 #d8c8b2;
        }

    .contact-sub {
        color: #6b5e55;
        margin-bottom: 30px;
    }

    /* FORM CARD */
    .contact-card {
        background: #fff8f0;
        padding: 30px;
        border-radius: 18px;
        box-shadow: 6px 6px 0 #e6d5c3;
        text-align: left;
        transition: 0.3s;
    }

        .contact-card:hover {
            transform: translateY(-6px);
            box-shadow: 10px 10px 0 #d8c3a5;
        }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        margin-bottom: 6px;
        color: #333;
        font-weight: 500;
    }

    input, textarea {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #ddd;
        background: #fff;
        transition: 0.3s;
    }

        input:focus, textarea:focus {
            outline: none;
            border-color: #e76f51;
            box-shadow: 0 0 6px #e76f51;
        }

    textarea {
        height: 110px;
        resize: none;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #f4a261, #e76f51);
        color: white;
        font-size: 15px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 4px 4px 0 #d8c3a5;
    }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 6px 6px 0 #c9b29b;
        }

  
    .contact-info {
        margin-top: 25px;
        color: #6b5e55;
    }

        .contact-info i {
            color: #e76f51;
            margin-right: 6px;
        }
</style>

<div class="contact-container">

    <div class="contact-title">
        Contact  Hamro<span>Dokaan</span>
    </div>

    <p class="contact-sub">
        Got questions, feedback, or just want to say hi? We'd love to hear from you 
    </p>

    <div class="contact-card">
        <form method="post" asp-action="ContactUs">

            <div class="form-group">
                <label>Name</label>
                <input type="text" name="Name" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="Email" required />
            </div>

            <div class="form-group">
                <label>Message</label>
                <textarea name="Message" required></textarea>
            </div>

            <button type="submit" class="btn-submit">
                Send Message 
            </button>

        </form>
    </div>

    <div class="contact-info">
        <p><i class="fa-solid fa-envelope"></i> HamroDokaan12@gmail.com</p>
        <p><i class="fa-solid fa-location-dot"></i> Nepal</p>
    </div>

</div>