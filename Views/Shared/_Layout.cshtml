<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - HamroDokaan</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #fdf6ec;
            }

          
            .header {
                padding: 10px 20px;
                border-bottom: 1px solid #ddd;
                background: #f8f8f8;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .logo {
                display: flex;
                align-items: center;
                text-decoration: none;
                color: black;
                gap: 12px;
            }

            .logo-icon {
                width: 45px;
                height: 45px;
                border-radius: 12px;
                background: linear-gradient(135deg, #f4a261, #e76f51);
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 20px;
                transition: all 0.3s ease;
                box-shadow: 4px 4px 0 #d8c8b2;
            }

            .logo:hover .logo-icon {
                transform: rotate(-8deg) scale(1.1);
                box-shadow: 6px 6px 0 #d8c8b2;
            }

            .logo-text {
                font-size: 22px;
                font-weight: bold;
                transition: 0.3s;
            }

                .logo-text span {
                    color: #e76f51;
                }

            .logo:hover .logo-text {
                letter-spacing: 1px;
            }

         
            .nav-links {
                display: flex;
                gap: 20px;
            }

                .nav-links a {
                    text-decoration: none;
                    color: #333;
                    font-size: 14px;
                    padding: 8px 14px;
                    border-radius: 10px;
                    transition: 0.3s;
                }

                    .nav-links a:hover {
                        background: #e76f51;
                        color: white;
                        transform: translateY(-2px);
                    }

            
            .main {
                padding: 15px 20px;
            }
    </style>
</head>

<body>

    <div class="header">

        <a asp-controller="Home" asp-action="Index" class="logo">
            <div class="logo-icon">
                <i class="fa-solid fa-store"></i>
            </div>
            <div class="logo-text">
                Hamro<span>Dokaan</span>
            </div>
        </a>


        <div class="nav-links">
            <a asp-controller="Home" asp-action="AboutUs">About Us</a>
            <a asp-controller="Home" asp-action="ContactUs">Contact Us</a>
        </div>

    </div>

 
    <div class="main">
        @RenderBody()
    </div>

</body>
</html>