@model HamroDokaan.Models.Product
@{
    Layout = "_AdminLayout";
}

<div class="delete-wrapper">

    <div class="delete-card">

        <h2>Delete Product</h2>

        <p class="warning">
            Are you sure you want to delete this product?
        </p>

        <div class="product-preview">
            <img src="@Model.Product_img" alt="Product Image" />

            <div class="info">
                <p><strong>Name:</strong> @Model.Product_Name</p>
                <p><strong>Price:</strong> Rs. @Model.Product_Price</p>
            </div>
        </div>

        <form asp-action="DeleteProduct" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Product_Id" />

            <div class="btn-group">
                <button type="submit" class="btn-delete">Yes, Delete</button>
                <a asp-action="Products" class="btn-cancel">Cancel</a>
            </div>
        </form>

    </div>

</div>

<style>
    body {
        background: linear-gradient(135deg, #f6f1e9, #efe6d8);
        font-family: 'Space Grotesk', sans-serif;
    }

    .delete-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 80vh;
    }

    .delete-card {
        width: 460px;
        padding: 30px;
        border-radius: 18px;
        background: rgba(255, 250, 243, 0.75);
        backdrop-filter: blur(14px);
        border: 1px solid #e5d6c3;
        box-shadow: 8px 8px 0 #e0d4c2, 0 20px 40px rgba(0,0,0,0.08);
        text-align: center;
    }

        .delete-card h2 {
            font-family: 'DM Serif Display', serif;
            margin-bottom: 10px;
        }

    .warning {
        color: #e76f51;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .product-preview {
        display: flex;
        gap: 15px;
        align-items: center;
        background: #fffaf3;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid #e5d6c3;
        margin-bottom: 20px;
    }

        .product-preview img {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 10px;
        }

    .info {
        text-align: left;
        font-size: 14px;
    }

    .btn-group {
        display: flex;
        gap: 10px;
    }

    .btn-delete {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(145deg, #e76f51, #d6452f);
        color: white;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 4px 4px 0 #d8c8b2;
        transition: 0.3s;
    }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 6px 6px 0 #d8c8b2;
        }

    .btn-cancel {
        flex: 1;
        padding: 10px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #d6c7b0;
        text-decoration: none;
        text-align: center;
        color: #333;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            background: #f3e8db;
        }
</style>